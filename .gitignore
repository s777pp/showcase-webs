.env

# NOTE: data/access_codes.json is intentionally COMMITTED — it is the master
# code list and ships with the deploy. Anyone with repo access gets free Pro.
# To stop that later: make the repo private, or untrack the file and move the
# codes to ACCESS_CODES_JSON / the /data volume.

# runtime state
data/used_codes.json
data/usage.json
data/users.db
data/auth.db
data/jobs/
data/gallery/
data/avatars/
data/profile_sc/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# local binaries / os
bin/*.exe
.DS_Store
Thumbs.db
