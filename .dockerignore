.git
.gitignore
.DS_Store
__pycache__
*.pyc
.venv
venv

# secrets / runtime state — must never enter the image
.env
data/used_codes.json
data/usage.json
data/users.db
data/jobs

# NOTE: data/access_codes.json IS shipped in the image on purpose — it is the
# master code list (trial codes carry "hours", which env vars cannot express).
# It is readable by anyone with the repo or the image.

*.md
!README.md
main2.py
bin/*.exe
docs

# Frontend: only node_modules is excluded. The sources ARE needed in the build
# context because the `frontend` stage compiles them; the runtime stage takes
# just the compiled output (static/react), so nothing extra ships in the image.
frontend/node_modules
