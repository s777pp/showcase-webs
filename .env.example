# Copy to .env and fill in production values

# Public URL (no trailing slash)
APP_URL=https://showcasemaker.com
ENABLE_API_DOCS=0

# Local working space for temporary processing files
DATA_DIR=/data

# HTTP port on host (docker compose nginx)
HTTP_PORT=8080
# Interface nginx is published on. Keep 127.0.0.1: requests arrive through the
# Cloudflare tunnel over the internal network, and a public bind would let
# anyone with the VPS IP reach the origin directly, past Cloudflare's WAF.
HTTP_BIND=127.0.0.1

# Secrets
# Generate once: openssl rand -hex 32
SECRET_KEY=
COOKIE_SECURE=1
SESSION_TTL_DAYS=30
PASSWORD_PBKDF2_ITERATIONS=600000

# PostgreSQL is the production source of truth. Generate a unique password;
# if it contains URL-reserved characters, URL-encode it in DATABASE_URL.
DATABASE_URL=postgresql://showcasemaker:replace_with_a_unique_database_password@postgres:5432/showcasemaker
POSTGRES_USER=showcasemaker
POSTGRES_PASSWORD=replace_with_a_unique_database_password
POSTGRES_DB=showcasemaker
# Max pooled PostgreSQL connections per process. Total server load is
# PG_POOL_MAX x (UVICORN_WORKERS + worker containers), so keep the product
# under the server's max_connections (default 100). 20 x (2 app + 1 worker) = 60.
PG_POOL_MAX=20

# Redis — optional. Without it jobs/quota/rate limits live in process memory.
REDIS_URL=redis://redis:6379/0

# embedded = jobs run in the API container's thread pool (use this on Railway,
#            and anywhere the API and the worker cannot share a volume)
# external = a separate `python worker.py` drains the Redis queue (docker compose)
# Container memory caps used by docker-compose.yml (VPS: 11 GB).
APP_MEM_LIMIT=3g
WORKER_MEM_LIMIT=6g
WORKER_MODE=external
MAX_JOB_WORKERS=1
# Seamless Loop quick previews rendered at the same time inside the API process.
LOOP_PREVIEW_CONCURRENCY=1
MAX_PROFILE_WORKERS=1
MAX_UPSCALE_WORKERS=4
MAX_JOBS_PER_USER=2
MAX_FILES_PER_JOB=10
# Completed ZIPs remain downloadable for this long on the shared /data volume.
JOB_RESULT_TTL_SECONDS=86400
# "My results": signed-in users keep finished Process/Workshop Studio ZIPs this long
# (private R2 when configured, otherwise /data/results). Oldest results beyond the cap are removed.
RESULTS_KEEP_DAYS=30
RESULTS_MAX_PER_USER=20
RESULTS_MAX_ZIP_MB=80
JOB_HISTORY_TTL_SECONDS=86400
ASSET_TTL_SECONDS=604800
ASSET_PENDING_TTL_SECONDS=86400
ASSET_CHUNK_SIZE=2097152

# Keep at 1 unless WORKER_MODE=external with shared storage: job results live on
# the disk of the process that produced them.
UVICORN_WORKERS=2

FREE_LIMIT=5
# Free plan beyond the daily files (smweb/free_limits.py):
# - uses per calendar week (Monday 00:00 UTC) of each weekly tool: AI background removal, Profile Rating, Steam DNA,
#   Seamless Loop, Design Selection, publishing to DeviantArt. Counted per account and per IP address.
FREE_WEEKLY_USES=1
# - Builder exports a day for a Free account.
BUILDER_EXPORTS_PER_DAY=3
# - tools in beta, Pro-only while listed here (ids: gifopt). Empty value = nothing is in beta.
BETA_FEATURES=gifopt
MAX_UPLOAD_MB=40
# Whole HTTP request ceiling. Character composition can contain two uploads,
# so keep this above 2 x MAX_UPLOAD_MB plus multipart overhead.
MAX_REQUEST_MB=100
MAX_IMAGE_PIXELS=40000000

# Access codes live in private /data/access_codes.json on the VPS. These vars
# can add emergency/temporary codes without rebuilding the image.
# Generate with: python scripts/gen_access_codes.py 10
ADMIN_ACCESS_CODE=
ACCESS_CODES=
# ACCESS_CODES_JSON={"SM-WEB-AAAAAA-BBBB":{"type":"unlimited","label":"Pro"}}

# Transactional e-mail via Resend (registration / password-reset codes).
# Without RESEND_API_KEY no code can be delivered and e-mail sign-up fails.
RESEND_API_KEY=
MAIL_FROM=Showcase Maker <no-reply@showcasemaker.com>

# OAuth / bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://showcasemaker.com/api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://showcasemaker.com/api/auth/google/callback

# DeviantArt integration (optional)
DA_CLIENT_ID=
DA_CLIENT_SECRET=
DA_REDIRECT_URI=https://showcasemaker.com/api/da/callback

# Steam OpenID login itself needs no key. The key enriches authorized profiles
# with owned/recent games, exact level and player summary data.
STEAM_API_KEY=

# Profile import by link tries: this server -> relay (second IP) -> Bright Data.
# Relay: deploy/steam-relay on another host (Oracle). Leave empty to skip it.
STEAM_RELAY_URL=
STEAM_RELAY_TOKEN=

# Owner's Telegram bot: notifications (tickets, job errors, disk, paid imports) are sent
# with this bot to this chat, and the bot calls /api/bot-admin with the shared secret.
ADMIN_BOT_TOKEN=
ADMIN_BOT_CHAT_ID=
# Telegram mini app at /tg (smweb/tg_app.py): checks Telegram's signature and sends results into the chat with
# this bot token. Empty = ADMIN_BOT_TOKEN. It must be the token of the bot whose button opens the app.
TG_APP_BOT_TOKEN=
BOT_ADMIN_SECRET=
# Pro bought in the bot (smweb/telegram_billing.py): with BOT_ADMIN_SECRET set, the purchase dialog opens
# t.me/<bot>?start=buy_<token> and the bot switches Pro on. The bot is TELEGRAM_BOT_USERNAME unless the shop
# bot is a different one; APP_URL is used for the claim link the bot sends to buyers without an account.
TELEGRAM_SHOP_BOT_USERNAME=

# Comma-separated account e-mails that skip request rate limits (owner testing).
RATE_LIMIT_EXEMPT_EMAILS=

# Bright Data Browser API — public Steam profile rendering (last fallback). Keep the password
# only in .env; never commit the full WebSocket URL or credentials.
BRIGHTDATA_BROWSER_USERNAME=
BRIGHTDATA_BROWSER_PASSWORD=
BRIGHTDATA_BROWSER_HOST=brd.superproxy.io
BRIGHTDATA_BROWSER_PORT=9222
STEAM_BROWSER_TIMEOUT_MS=90000

# Service watermark used by profile/tool exports
SERVICE_WM_TEXT=Showcase Maker

# Gumroad Pro plans (smweb/gumroad_billing.py). The access token comes from Gumroad Settings > Advanced >
# Applications > Generate access token. Without it the site shows no plans and Pings are only logged.
# Ping endpoint to set in Gumroad: https://showcasemaker.com/api/billing/gumroad
GUMROAD_ACCESS_TOKEN=
# Optional: ignore Pings whose seller_id differs (every sale is verified through the API anyway).
GUMROAD_SELLER_ID=
# Fallback store address when the product list cannot be read.
GUMROAD_STORE_URL=https://serhiiperepelytsia.gumroad.com

# Stripe
STRIPE_SECRET_KEY=
# Required for /api/billing/webhook: without it the endpoint returns 503
# rather than trusting an unsigned event that could grant Pro to anyone.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---- Security ----
# How many proxies in front of the app append to X-Forwarded-For.
#   1 = Railway edge, or the Nginx from docker-compose (default)
#   0 = app exposed directly with no proxy
#   2 = Cloudflare in front of Nginx
# Quota and rate limits count from the RIGHT of the header using this, so a
# wrong value here either shares one bucket between users (too high) or lets
# clients forge their own address (too low).
TRUSTED_PROXY_HOPS=2
# Comma-separated origins allowed to perform cookie-authenticated writes.
TRUSTED_ORIGINS=https://showcasemaker.com
ALLOWED_HOSTS=showcasemaker.com,www.showcasemaker.com

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare R2 persistent media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=showcasemaker-public
R2_PRIVATE_BUCKET=showcasemaker-private
R2_PUBLIC_BASE_URL=https://media.showcasemaker.com
R2_REGION=auto

# Modal GPU upscale. Deploy modal_upscale.py, then create a Proxy Auth token.
# Keep both token values only in the VPS .env; never commit or paste them.
MODAL_UPSCALE_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_UPSCALE_POLL_SECONDS=3
MODAL_UPSCALE_TIMEOUT_SECONDS=3600
MODAL_UPSCALE_MAX_UPLOAD_MB=40

# YouTube asks datacenter IPs to sign in: cookies.txt of a spare account (default
# /data/yt-cookies.txt, see DEPLOY.md) and/or a residential proxy for yt-dlp only.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=

# AI background removal for still PNG/JPG/WebP layers in Builder. Every provider is
# optional; the Builder offers the configured ones and falls back to the next when one is down.
# 1) Our BiRefNet service on Modal: py -m modal deploy modal_bg_remove.py prints the URL of
#    the "api" web function. It uses the MODAL_PROXY_TOKEN_* above.
MODAL_BG_REMOVE_URL=
# 2) iLoveAPI (250 free images a month): the project's PUBLIC key from iloveapi.com -> API keys.
ILOVEAPI_PUBLIC_KEY=
ILOVEAPI_REGION=eu
# 3) Problembo (paid per image): API token from problembo.com -> account -> API.
PROBLEMBO_API_TOKEN=
# 4) remove.bg (paid per image).
REMOVE_BG_API_KEY=
# Fallback order and switch (0 = only the chosen / first provider).
BG_REMOVE_ORDER=modal,iloveapi,problembo,removebg
BG_REMOVE_FALLBACK=1
# Monthly caps per provider (calendar month, whole site).
BG_REMOVE_MONTHLY_MODAL=5000
BG_REMOVE_MONTHLY_ILOVEAPI=240
BG_REMOVE_MONTHLY_PROBLEMBO=100
BG_REMOVE_MONTHLY_REMOVEBG=50
# Pro: removals a day per account. Free accounts get FREE_WEEKLY_USES a week (see below). Plus a site-wide daily cap.
REMOVE_BG_PRO_DAILY=20
BG_REMOVE_GLOBAL_DAILY=300

# AI animation (beta, Pro only; smweb/ai_animate.py): MiniMax H3 on fal.ai, about $0.30 per animation.
# Without FAL_KEY the tab says the tool is unavailable. Beta: AI_ANIMATE_BETA_FREE animations per Pro account for the
# whole beta (more only from the admin user card), plus a site-wide daily budget (UTC day). A refused, failed or
# cancelled animation gives its use back. AI_ANIMATE_ENDPOINT switches the fal model.
FAL_KEY=
AI_ANIMATE_BETA_FREE=1
AI_ANIMATE_GLOBAL_DAILY=30
# AI_ANIMATE_ENDPOINT=minimax/h3/image-to-video

# Gemini API for Profile Doctor and Smart Design. This is an API key from
# Google AI Studio, not a Google One / Gemini subscription credential.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PROFILE_AI_PRO_DAILY=30

# Header X-Admin-Secret for /api/admin/* and gallery moderation. Unset = denied.
ADMIN_SECRET=

# Comma-separated moderator emails for the gallery.
GALLERY_ADMIN_EMAILS=

LOG_LEVEL=INFO

# Optional public support assistant on Groq. Keep the Groq account on Free.
# Leave blank to keep the bilingual help center available without AI calls.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_DNA_MODEL=openai/gpt-oss-20b
# Pro: analyses a day per account. Free accounts get FREE_WEEKLY_USES a week (see below).
STEAM_DNA_PRO_DAILY=20
STEAM_DNA_GLOBAL_DAILY=150
STEAM_DNA_CACHE_SEC=3600
SUPPORT_CHAT_DAILY=20
SUPPORT_CHAT_GLOBAL_DAILY=300
# Uses Responses API, low reasoning, max 1600 output tokens, no stored responses.
# No fallback to OpenAI or another provider. Provider quotas may be lower.
# Use Redis in production for a shared, fail-closed request cap; configure APP_URL
# and TRUSTED_PROXY_HOPS for your actual reverse-proxy topology.
# Detailed first-party analytics are automatically deleted after this many days (30-365).
ANALYTICS_RETENTION_DAYS=90
