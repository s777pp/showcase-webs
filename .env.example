# Copy to .env and fill in production values

# Public URL (no trailing slash)
APP_URL=https://steamshowcase.example.com

# Persistent application data (Railway volume mount path)
DATA_DIR=/data

# HTTP port on host (docker compose nginx)
HTTP_PORT=80

# Secrets
SECRET_KEY=generate-a-long-random-string

# Optional PostgreSQL (leave empty to keep SQLite on /data/users.db)
# DATABASE_URL=postgresql://showcase:showcase_change_me@postgres:5432/showcase
POSTGRES_USER=showcase
POSTGRES_PASSWORD=showcase_change_me
POSTGRES_DB=showcase

# Redis — optional. Without it jobs/quota/rate limits live in process memory.
REDIS_URL=redis://redis:6379/0

# embedded = jobs run in the API container's thread pool (use this on Railway,
#            and anywhere the API and the worker cannot share a volume)
# external = a separate `python worker.py` drains the Redis queue (docker compose)
WORKER_MODE=embedded
MAX_JOB_WORKERS=2
MAX_JOBS_PER_USER=2

# Keep at 1 unless WORKER_MODE=external with shared storage: job results live on
# the disk of the process that produced them.
UVICORN_WORKERS=1

FREE_LIMIT=5
MAX_UPLOAD_MB=40

# Access codes: the master list is data/access_codes.json (committed, shipped in
# the image). These vars only ADD to it — leave empty unless you need extras.
# Generate with: python scripts/gen_access_codes.py 10
ADMIN_ACCESS_CODE=
ACCESS_CODES=
# ACCESS_CODES_JSON={"SM-WEB-AAAAAA-BBBB":{"type":"unlimited","label":"Pro"}}

# OAuth / bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://steamshowcase.example.com/api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://steamshowcase.example.com/api/auth/google/callback

# DeviantArt integration (optional)
DA_CLIENT_ID=
DA_CLIENT_SECRET=
DA_REDIRECT_URI=https://steamshowcase.example.com/api/da/callback

# Steam profile/catalog does not use a STEAM_API_KEY. It reads public Steam
# Community endpoints; the profile URL must be public and Railway needs outbound HTTPS.

# Service watermark used by profile/tool exports
SERVICE_WM_TEXT=Showcase Maker

# Stripe
STRIPE_SECRET_KEY=
# Required for /api/billing/webhook: without it the endpoint returns 503
# rather than trusting an unsigned event that could grant Pro to anyone.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---- Security ----
# How many proxies in front of the app append to X-Forwarded-For.
#   1 = Railway edge, or the Nginx from docker-compose (default)
#   0 = app exposed directly with no proxy
#   2 = Cloudflare in front of Nginx
# Quota and rate limits count from the RIGHT of the header using this, so a
# wrong value here either shares one bucket between users (too high) or lets
# clients forge their own address (too low).
TRUSTED_PROXY_HOPS=1

# Header X-Admin-Secret for /api/admin/* and gallery moderation. Unset = denied.
ADMIN_SECRET=

# Comma-separated moderator emails for the gallery.
GALLERY_ADMIN_EMAILS=

# Pillow decompression-bomb ceiling, in pixels.
MAX_IMAGE_PIXELS=100000000

LOG_LEVEL=INFO
