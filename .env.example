# Copy to .env and fill in production values

# Public URL (no trailing slash)
APP_URL=https://showcasemaker.com

# Local working space for temporary processing files
DATA_DIR=/data

# HTTP port on host (docker compose nginx)
HTTP_PORT=8080
# Interface nginx is published on. Keep 127.0.0.1: requests arrive through the
# Cloudflare tunnel over the internal network, and a public bind would let
# anyone with the VPS IP reach the origin directly, past Cloudflare's WAF.
HTTP_BIND=127.0.0.1

# Secrets
# Generate once: openssl rand -hex 32
SECRET_KEY=
COOKIE_SECURE=1
SESSION_TTL_DAYS=30
PASSWORD_PBKDF2_ITERATIONS=600000

# PostgreSQL is the production source of truth
DATABASE_URL=postgresql://showcasemaker:change-me@postgres:5432/showcasemaker
POSTGRES_USER=showcasemaker
POSTGRES_PASSWORD=showcase_change_me
POSTGRES_DB=showcasemaker
# Max pooled PostgreSQL connections per process. Total server load is
# PG_POOL_MAX x (UVICORN_WORKERS + worker containers), so keep the product
# under the server's max_connections (default 100).
PG_POOL_MAX=10

# Redis — optional. Without it jobs/quota/rate limits live in process memory.
REDIS_URL=redis://redis:6379/0

# embedded = jobs run in the API container's thread pool (use this on Railway,
#            and anywhere the API and the worker cannot share a volume)
# external = a separate `python worker.py` drains the Redis queue (docker compose)
WORKER_MODE=external
MAX_JOB_WORKERS=1
MAX_PROFILE_WORKERS=1
MAX_JOBS_PER_USER=2
MAX_FILES_PER_JOB=10
ALLOW_SYNC_PROCESS=0
# Completed ZIPs remain downloadable for this long on the shared /data volume.
JOB_RESULT_TTL_SECONDS=900

# Keep at 1 unless WORKER_MODE=external with shared storage: job results live on
# the disk of the process that produced them.
UVICORN_WORKERS=2

FREE_LIMIT=5
MAX_UPLOAD_MB=40
MAX_IMAGE_PIXELS=40000000

# Access codes live in private /data/access_codes.json on the VPS. These vars
# can add emergency/temporary codes without rebuilding the image.
# Generate with: python scripts/gen_access_codes.py 10
ADMIN_ACCESS_CODE=
ACCESS_CODES=
# ACCESS_CODES_JSON={"SM-WEB-AAAAAA-BBBB":{"type":"unlimited","label":"Pro"}}

# OAuth / bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://showcasemaker.com/api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://showcasemaker.com/api/auth/google/callback

# DeviantArt integration (optional)
DA_CLIENT_ID=
DA_CLIENT_SECRET=
DA_REDIRECT_URI=https://showcasemaker.com/api/da/callback

# Steam OpenID login itself needs no key. The key enriches authorized profiles
# with owned/recent games, exact level and player summary data.
STEAM_API_KEY=

# Bright Data Browser API — public Steam profile rendering. Keep the password
# only in .env; never commit the full WebSocket URL or credentials.
BRIGHTDATA_BROWSER_USERNAME=
BRIGHTDATA_BROWSER_PASSWORD=
BRIGHTDATA_BROWSER_HOST=brd.superproxy.io
BRIGHTDATA_BROWSER_PORT=9222
STEAM_BROWSER_TIMEOUT_MS=90000

# Service watermark used by profile/tool exports
SERVICE_WM_TEXT=Showcase Maker

# Stripe
STRIPE_SECRET_KEY=
# Required for /api/billing/webhook: without it the endpoint returns 503
# rather than trusting an unsigned event that could grant Pro to anyone.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---- Security ----
# How many proxies in front of the app append to X-Forwarded-For.
#   1 = Railway edge, or the Nginx from docker-compose (default)
#   0 = app exposed directly with no proxy
#   2 = Cloudflare in front of Nginx
# Quota and rate limits count from the RIGHT of the header using this, so a
# wrong value here either shares one bucket between users (too high) or lets
# clients forge their own address (too low).
TRUSTED_PROXY_HOPS=2
# Comma-separated origins allowed to perform cookie-authenticated writes.
TRUSTED_ORIGINS=https://showcasemaker.com
ALLOWED_HOSTS=showcasemaker.com,www.showcasemaker.com

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare R2 persistent media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=showcasemaker-public
R2_PRIVATE_BUCKET=showcasemaker-private
R2_PUBLIC_BASE_URL=https://media.showcasemaker.com
R2_REGION=auto

# Header X-Admin-Secret for /api/admin/* and gallery moderation. Unset = denied.
ADMIN_SECRET=

# Comma-separated moderator emails for the gallery.
GALLERY_ADMIN_EMAILS=

# Pillow decompression-bomb ceiling, in pixels.
MAX_IMAGE_PIXELS=100000000

LOG_LEVEL=INFO
